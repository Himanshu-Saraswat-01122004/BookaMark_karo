{
    "manifest_version": 3,
    "name": "Bookmark Karo",
    "version": "1.0",
    "description": "Save timestamps in videos with notes",
    "permissions": [
      "storage",
      "activeTab",
      "scripting"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "star.png",
        "48": "star.png",
        "128": "star.png"
      }
    },
    "icons": {
      "16": "star.png",
      "48": "star.png",
      "128": "star.png"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }
  